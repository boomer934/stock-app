generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Risk {
  LOW
  MEDIUM
  HIGH
}

model User {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  password    String
  nationality String
  risk        Risk     @default(LOW)
  alert Alert[]
  created_at  DateTime @default(now())
}

model Alert {
  id Int @id @default(autoincrement())
  user_id Int 
  user User @relation(fields: [user_id],references: [id])
  name String
  description String?
  target Float
  isTriggered Boolean @default(false)
}
